# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (needed for the
# standalone frontend at http://localhost:5173 and for embedding elsewhere).
CORS_ORIGINS=http://localhost:5173
# Max upload size in MB. Real Pravaig decks run large (the sample induction
# PPTX is ~40MB), so the default is set well above that.
MAX_UPLOAD_MB=60

# --- Model provider (provider-agnostic; see src/modelProvider) ---
# Which provider implementation to use. Only "gemini" is implemented today;
# adding another provider means adding a new file in src/modelProvider and
# registering it in src/modelProvider/index.ts, then flipping this value.
MODEL_PROVIDER=gemini

# Google AI Studio API key (https://aistudio.google.com/apikey).
# Required when MODEL_PROVIDER=gemini. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Storage (local disk paths, all relative to backend/ unless absolute) ---
DATA_DIR=./data
BRAND_SOURCE_DIR=./brand-source
BRAND_REFERENCE_PATH=./data/brand-reference.md
UPLOADS_DIR=./data/uploads
GENERATED_DIR=./data/generated

# --- Review / access control ---
# Comma-separated list of reviewer names or emails allowed to approve output
# and submit corrections (P1 in the PRD; enforced loosely for now — see
# src/routes/review.ts for where real auth would plug in).
REVIEWERS=Monika,Ram
